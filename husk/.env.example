# Copy to ./.env (project folder) or ~/.husk/.env. Environment variables override both files.
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000        # used to build the OAuth redirect URI
FRONTEND_URL=http://localhost:5173

# Default is ~/.husk/data/husk.db. Uncomment to use a project-local database instead.
# DATABASE_URL=sqlite:///./data/husk.db
AUTO_MIGRATE=true                            # run `alembic upgrade head` on startup (source installs)
ENABLE_WORKERS=true                          # agent worker + automation scheduler

LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14

# Comma separated (or a JSON array)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]      # Host headers accepted (DNS-rebinding guard)

HISTORY_RETENTION_DAYS=5                     # default window for GET /history
HISTORY_AUTO_PRUNE=false                     # true = permanently delete chats older than the window
MAX_HISTORY_MESSAGES=40                      # context sent to the LLM per request

# Mail + calendar sign-in (leave blank to disable a provider).
# Register this redirect URI with each provider:  <PUBLIC_BASE_URL>/api/v1/mail/accounts/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
